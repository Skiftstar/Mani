# Fetched at build time by downloadMpvForWindows (desktopApp/build.gradle.kts) rather than
# committed - too large for a normal git push (GitHub's 100MB per-file limit).
desktopApp/resources/windows/mpv.exe
desktopApp/resources/windows/d3dcompiler_43.dll

# makepkg build artifacts (packaging/arch/PKGBUILD) - src/ and pkg/ are makepkg's own internal
# working directories; mani/ is the actual git checkout it clones per the PKGBUILD's
# source=("$pkgname::git+...") (named after pkgname, not nested under src/ as might be expected).
packaging/arch/src/
packaging/arch/pkg/
packaging/arch/mani/
packaging/arch/*.pkg.tar.*

