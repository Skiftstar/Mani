# Maintainer: Skiftstar
# Local-build-only for now (per an explicit request not to publish to the AUR yet) - see the
# rough edges noted below before ever actually submitting this.
pkgname=mani
pkgver=1.0.0
pkgrel=1
pkgdesc="A Subsonic/Navidrome desktop music client"
arch=('x86_64')
url="https://github.com/Skiftstar/Mani"
license=('GPL3')
depends=('mpv')
makedepends=('jdk17-openjdk')
source=()
sha256sums=()

prepare() {
    rm -rf "$pkgname"
    mkdir -p "$pkgname"
    # $startdir is this PKGBUILD's own directory (packaging/arch) - ../.. is the repo root. Copies
    # the live working tree, uncommitted changes included, rather than fetching a GitHub clone.
    # Excludes .git (irrelevant to the build), packaging (this directory itself - copying it in
    # would recurse into its own src/pkg output) and build/.gradle (stale build output/caches that
    # should be rebuilt fresh here, not reused from the host checkout).
    tar -C "$startdir/../.." \
        --exclude='.git' --exclude='packaging' --exclude='build' --exclude='.gradle' \
        -cf - . | tar -C "$pkgname" -xf -
}

build() {
    cd "$pkgname"
    ./gradlew :desktopApp:packageReleaseAppImage --no-daemon
}

package() {
    cd "$pkgname"
    # Confirmed against a real packageReleaseAppImage run - jpackage names the app-image folder
    # and its launcher binary after packageName (desktopApp/build.gradle.kts), not something
    # friendlier - both really are "xyz.skifty.mani", not "Mani".
    local appimage_dir="desktopApp/build/compose/binaries/main-release/app/xyz.skifty.mani"
    install -dm755 "$pkgdir/opt/$pkgname"
    cp -r "$appimage_dir"/* "$pkgdir/opt/$pkgname/"
    install -dm755 "$pkgdir/usr/bin"
    ln -s "/opt/$pkgname/bin/xyz.skifty.mani" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "$srcdir/../mani.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
}
